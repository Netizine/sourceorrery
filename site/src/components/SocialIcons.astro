---
import config from 'virtual:starlight/user-config';
import FAIcon from './FAIcon.astro';

const links = config.social || [];
const brands: Record<string, string> = {
	github: 'github', gitlab: 'gitlab', discord: 'discord', mastodon: 'mastodon',
	twitter: 'x-twitter', 'x.com': 'x-twitter', youtube: 'youtube', linkedin: 'linkedin',
};
---

{links.map(({ label, href, icon }) => (
	<a {href} rel="me noopener noreferrer" target="_blank" class="so-social-link sl-flex" aria-label={label} title={label}>
		<FAIcon name={brands[icon] || 'arrow-up-right-from-square'} family={brands[icon] ? 'brands' : 'duotone'} />
	</a>
))}
