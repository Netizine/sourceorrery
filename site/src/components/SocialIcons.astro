---
/**
 * Starlight's SocialIcons (the GitHub icon in the header) with every link
 * opening in a new tab. Same markup and styles as the original in
 * @astrojs/starlight/components/SocialIcons.astro, plus target and rel.
 */
import config from 'virtual:starlight/user-config';
import { Icon } from '@astrojs/starlight/components';

const links = config.social || [];
---

{
	links.length > 0 && (
		<>
			{links.map(({ label, href, icon }) => (
				<a {href} rel="me noopener noreferrer" target="_blank" class="sl-flex">
					<span class="sr-only">{label}</span>
					<Icon name={icon} />
				</a>
			))}
		</>
	)
}

<style>
	@layer starlight.core {
		a {
			color: var(--sl-color-text-accent);
			padding: 0.5em;
			margin: -0.5em;
		}
		a:hover {
			color: var(--sl-color-white);
		}
	}
</style>
