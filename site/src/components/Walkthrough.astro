---
/**
 * A walkthrough of one of the CLI's screens: its design snapshots shown one
 * at a time in a terminal frame, with Previous / Next, a step list and a
 * caption per screen. Each slide is a page under public/walkthrough/ shown
 * in an iframe, so the snapshot's own styling stays apart from the site's.
 * The terminal follows the site's theme; Dark / Light overrides it for this
 * walkthrough. Slides and captions: src/lib/walkthroughs.mjs.
 */
import FAIcon from './FAIcon.astro';
import { slideUrl, walkthroughs } from '../lib/walkthroughs.mjs';
import sizes from '../lib/walkthrough-sizes.json';

interface Props {
	/** A key of `walkthroughs`: setup, browser or init. */
	name: string;
}

const { name } = Astro.props;
const walkthrough = walkthroughs[name];
if (!walkthrough) throw new Error(`Walkthrough: no walkthrough named ${name}`);
const slides = walkthrough.slides.map((slide) => {
	const size = sizes[slide.state];
	if (!size) throw new Error(`Walkthrough ${name}: no size for ${slide.state}; run npm run walkthroughs`);
	return { ...slide, rows: size.rows, cols: size.cols };
});
// Every slide is drawn in a frame as tall as the tallest, so the controls
// stay put from one screen to the next.
const rows = Math.max(...slides.map((s) => s.rows));
const cols = Math.max(...slides.map((s) => s.cols));
const first = slides[0];
const id = `so-walkthrough-${name}`;
---

<so-walkthrough
	class="so-walkthrough not-content"
	data-slides={JSON.stringify(slides.map(({ state, title, caption }) => ({ state, title, caption })))}
	data-rows={rows}
	data-cols={cols}
	aria-roledescription="walkthrough"
	aria-label={`${walkthrough.label}: the screens of ${walkthrough.command}`}
>
	<figure>
		<div class="so-walkthrough__window">
			<div class="so-walkthrough__bar">
				<span class="so-walkthrough__lights" aria-hidden="true"><i></i><i></i><i></i></span>
				<code class="so-walkthrough__command">{walkthrough.command}</code>
				<a
					class="so-walkthrough__full"
					data-full
					href={slideUrl('dark', first.state)}
					target="_blank"
					rel="noopener"
					title="This screen at full size, in a new tab"
				>
					<FAIcon name="arrow-up-right" /><span class="so-walkthrough__label">Full size</span>
				</a>
				<span class="so-walkthrough__looks" role="group" aria-label="Terminal colours">
					<button type="button" data-look="dark" aria-pressed="false" title="Dark terminal">
						<FAIcon name="moon" /><span class="so-walkthrough__label">Dark</span>
					</button>
					<button type="button" data-look="light" aria-pressed="false" title="Light terminal">
						<FAIcon name="sun" /><span class="so-walkthrough__label">Light</span>
					</button>
				</span>
			</div>
			<div class="so-walkthrough__viewport" data-viewport>
				<iframe
					src={slideUrl('dark', first.state)}
					title={`${walkthrough.command}: ${first.title}`}
					loading="lazy"
					sandbox="allow-same-origin"
					scrolling="no"
					tabindex="-1"
				></iframe>
			</div>
		</div>
		<figcaption id={`${id}-caption`} aria-live="polite">
			<span class="so-walkthrough__count" data-count>1 / {slides.length}</span>
			<strong data-title>{first.title}</strong>
			<span data-caption>{first.caption}</span>
		</figcaption>
		<nav class="so-walkthrough__nav" aria-label={`${walkthrough.label} screens`}>
			<button type="button" class="so-walkthrough__step-button" data-prev disabled>
				<FAIcon name="chevron-left" /><span>Previous</span>
			</button>
			<ol class="so-walkthrough__steps">
				{
					slides.map((slide, i) => (
						<li>
							<button
								type="button"
								data-goto={i}
								aria-current={i === 0 ? 'step' : undefined}
								aria-label={`Screen ${i + 1}: ${slide.title}`}
								title={slide.title}
							>
								{i + 1}
							</button>
						</li>
					))
				}
			</ol>
			<button type="button" class="so-walkthrough__step-button" data-next disabled={slides.length === 1}>
				<span>Next</span><FAIcon name="chevron-right" />
			</button>
		</nav>
	</figure>
</so-walkthrough>

<script>
	type Slide = { state: string; title: string; caption: string };
	type Look = 'dark' | 'light';

	const siteLook = (): Look => (document.documentElement.dataset.theme === 'light' ? 'light' : 'dark');

	class SoWalkthrough extends HTMLElement {
		#slides: Slide[] = [];
		#index = 0;
		#chosen: Look | null = null;
		#frame!: HTMLIFrameElement;
		#viewport!: HTMLElement;
		#observers: (MutationObserver | ResizeObserver)[] = [];

		connectedCallback() {
			this.#slides = JSON.parse(this.dataset.slides ?? '[]');
			this.#frame = this.querySelector('iframe')!;
			this.#viewport = this.querySelector('[data-viewport]')!;
			this.querySelector('[data-prev]')!.addEventListener('click', () => this.go(this.#index - 1));
			this.querySelector('[data-next]')!.addEventListener('click', () => this.go(this.#index + 1));
			for (const button of this.querySelectorAll<HTMLButtonElement>('[data-goto]')) {
				button.addEventListener('click', () => this.go(Number(button.dataset.goto)));
			}
			for (const button of this.querySelectorAll<HTMLButtonElement>('[data-look]')) {
				button.addEventListener('click', () => {
					this.#chosen = button.dataset.look as Look;
					this.render();
				});
			}
			this.addEventListener('keydown', (event) => {
				if (event.target instanceof HTMLInputElement) return;
				if (event.key === 'ArrowLeft') this.go(this.#index - 1);
				else if (event.key === 'ArrowRight') this.go(this.#index + 1);
				else return;
				event.preventDefault();
			});
			this.#frame.addEventListener('load', () => this.fit());
			// The first screen may have loaded before this script ran.
			if (this.#frame.contentDocument?.readyState === 'complete') this.fit();
			const theme = new MutationObserver(() => this.#chosen === null && this.render());
			theme.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
			const resize = new ResizeObserver(() => this.fit());
			resize.observe(this.#viewport);
			this.#observers = [theme, resize];
			this.render();
		}

		disconnectedCallback() {
			for (const observer of this.#observers) observer.disconnect();
		}

		get look(): Look {
			return this.#chosen ?? siteLook();
		}

		go(index: number) {
			if (index < 0 || index >= this.#slides.length || index === this.#index) return;
			this.#index = index;
			this.render();
		}

		render() {
			const slide = this.#slides[this.#index];
			const look = this.look;
			const src = `/walkthrough/${look}/${slide.state}.html`;
			if (this.#frame.getAttribute('src') !== src) this.#frame.setAttribute('src', src);
			this.querySelector<HTMLAnchorElement>('[data-full]')!.href = src;
			this.#frame.title = `${this.querySelector('code')?.textContent ?? ''}: ${slide.title}`;
			this.dataset.look = look;
			this.querySelector('[data-count]')!.textContent = `${this.#index + 1} / ${this.#slides.length}`;
			this.querySelector('[data-title]')!.textContent = slide.title;
			this.querySelector('[data-caption]')!.textContent = slide.caption;
			(this.querySelector('[data-prev]') as HTMLButtonElement).disabled = this.#index === 0;
			(this.querySelector('[data-next]') as HTMLButtonElement).disabled = this.#index === this.#slides.length - 1;
			for (const button of this.querySelectorAll<HTMLButtonElement>('[data-goto]')) {
				if (Number(button.dataset.goto) === this.#index) button.setAttribute('aria-current', 'step');
				else button.removeAttribute('aria-current');
			}
			for (const button of this.querySelectorAll<HTMLButtonElement>('[data-look]')) {
				button.setAttribute('aria-pressed', String(button.dataset.look === look));
			}
			// The neighbours, so Next and Previous show at once.
			for (const near of [this.#index - 1, this.#index + 1]) {
				const neighbour = this.#slides[near];
				if (!neighbour) continue;
				const href = `/walkthrough/${look}/${neighbour.state}.html`;
				if (!document.head.querySelector(`link[rel="prefetch"][href="${href}"]`)) {
					const link = document.createElement('link');
					link.rel = 'prefetch';
					link.href = href;
					document.head.append(link);
				}
			}
		}

		/** Size the frame to the terminal it shows, scaled to the column's width. */
		fit() {
			const pre = this.#frame.contentDocument?.querySelector('pre');
			if (!pre) return;
			const shownRows = pre.textContent?.replace(/\n$/, '').split('\n').length ?? 1;
			const style = getComputedStyle(pre);
			const padding = parseFloat(style.paddingTop) + parseFloat(style.paddingBottom);
			const rowHeight = (pre.offsetHeight - padding) / shownRows;
			const width = pre.offsetWidth;
			const height = Math.ceil(Number(this.dataset.rows) * rowHeight + padding);
			const scale = Math.min(1, this.#viewport.clientWidth / width);
			this.#frame.style.width = `${width}px`;
			this.#frame.style.height = `${height}px`;
			this.#frame.style.transform = `scale(${scale})`;
			this.#viewport.style.height = `${Math.ceil(height * scale)}px`;
		}
	}

	if (!customElements.get('so-walkthrough')) customElements.define('so-walkthrough', SoWalkthrough);
</script>

<style>
	.so-walkthrough {
		display: block;
		margin-block: 1.5rem 2rem;
	}

	.so-walkthrough figure {
		margin: 0;
	}

	.so-walkthrough__window {
		border: 1px solid var(--sl-color-hairline-shade);
		border-radius: 2px;
		overflow: hidden;
		background: #0c0c0c;
	}

	.so-walkthrough[data-look='light'] .so-walkthrough__window {
		background: #fafafa;
	}

	.so-walkthrough__bar {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.35rem 0.6rem;
		background: var(--so-panel);
		border-bottom: 1px solid var(--sl-color-hairline-shade);
		font-family: var(--so-font-ui);
		font-size: 0.8rem;
	}

	.so-walkthrough__lights {
		display: inline-flex;
		gap: 0.35rem;
	}

	.so-walkthrough__lights i {
		width: 0.6rem;
		height: 0.6rem;
		border-radius: 50%;
		background: var(--sl-color-gray-4);
	}

	.so-walkthrough__command {
		flex: 1;
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		color: var(--sl-color-gray-2);
		background: none;
		font-size: 0.8rem;
	}

	.so-walkthrough__full {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		font-size: 0.75rem;
		color: var(--sl-color-gray-2);
		text-decoration: none;
	}

	.so-walkthrough__full:hover {
		color: var(--sl-color-text-accent);
	}

	.so-walkthrough__looks {
		display: inline-flex;
		border: 1px solid var(--sl-color-hairline-shade);
		border-radius: 2px;
	}

	.so-walkthrough__looks button,
	.so-walkthrough__nav button {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font: inherit;
		font-family: var(--so-font-ui);
		color: var(--sl-color-text);
		background: none;
		border: 0;
		cursor: pointer;
	}

	.so-walkthrough__looks button {
		padding: 0.15rem 0.5rem;
		font-size: 0.75rem;
	}

	.so-walkthrough__looks button[aria-pressed='true'] {
		background: var(--sl-color-accent-low);
		color: var(--sl-color-text-accent);
	}

	.so-walkthrough__viewport {
		position: relative;
		overflow: hidden;
		/* Until the first screen is measured: a 120 × 30 terminal. */
		aspect-ratio: 1020 / 594;
	}

	.so-walkthrough__viewport[style*='height'] {
		aspect-ratio: auto;
	}

	.so-walkthrough__viewport iframe {
		position: absolute;
		inset: 0 auto auto 0;
		border: 0;
		transform-origin: 0 0;
		pointer-events: none;
	}

	.so-walkthrough figcaption {
		margin-top: 0.75rem;
		font-family: var(--so-font-ui);
		font-size: 0.9rem;
		line-height: 1.5;
		color: var(--sl-color-gray-2);
		min-height: 3em;
	}

	.so-walkthrough figcaption strong {
		color: var(--sl-color-text);
		margin-inline: 0.35rem 0.25rem;
	}

	.so-walkthrough__count {
		font-variant-numeric: tabular-nums;
		color: var(--sl-color-gray-3);
	}

	.so-walkthrough__nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		margin-top: 0.5rem;
	}

	.so-walkthrough__step-button {
		padding: 0.35rem 0.75rem;
		border: 1px solid var(--sl-color-gray-4) !important;
		border-radius: 2px;
		font-size: 0.85rem;
		font-weight: 600;
	}

	.so-walkthrough__step-button:disabled {
		opacity: 0.4;
		cursor: default;
	}

	.so-walkthrough__step-button:not(:disabled):hover {
		border-color: var(--sl-color-accent) !important;
		color: var(--sl-color-text-accent);
	}

	.so-walkthrough__steps {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.so-walkthrough__steps li {
		margin: 0;
	}

	.so-walkthrough__steps button {
		min-width: 1.6rem;
		height: 1.6rem;
		justify-content: center;
		border-radius: 2px;
		font-size: 0.75rem;
		font-variant-numeric: tabular-nums;
		color: var(--sl-color-gray-3);
	}

	.so-walkthrough__steps button:hover {
		color: var(--sl-color-text);
	}

	.so-walkthrough__steps button[aria-current='step'] {
		background: var(--so-button-bg);
		color: var(--so-button-fg);
		font-weight: 600;
	}

	.so-walkthrough button:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}

	@media (max-width: 40rem) {
		.so-walkthrough__steps {
			display: none;
		}

		.so-walkthrough__label {
			display: none;
		}
	}
</style>
