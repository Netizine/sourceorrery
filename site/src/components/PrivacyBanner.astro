<section id="so-privacy-banner" class="so-consent" role="region" aria-label="Analytics cookies" aria-describedby="so-privacy-description" hidden data-pagefind-ignore data-clarity-mask="true">
  <div class="so-consent__message">
    <p id="so-privacy-description">We use analytics cookies to understand how you use our website and help us improve it. You can choose to accept or reject them.</p>
    <p id="so-privacy-status" class="so-consent__status" aria-live="polite" hidden></p>
  </div>
  <div class="so-consent__actions">
    <button type="button" data-analytics-choice="granted"><span aria-hidden="true">✓</span> Accept</button>
    <button type="button" data-analytics-choice="denied"><span aria-hidden="true">✕</span> Reject</button>
  </div>
</section>

<script>
  type Analytics = {
    choice(): 'granted' | 'denied' | null;
    browserOptOut(): boolean;
    choose(choice: 'granted' | 'denied'): void;
    open(): void;
  };
  const api = (window as Window & { sourceorreryAnalytics?: Analytics }).sourceorreryAnalytics;
  const banner = document.querySelector<HTMLElement>('#so-privacy-banner');
  if (api && banner) {
    let returnFocus: HTMLElement | null = null;
    const status = banner.querySelector<HTMLElement>('#so-privacy-status')!;
    const allow = banner.querySelector<HTMLButtonElement>('[data-analytics-choice="granted"]')!;
    const space = () => document.documentElement.style.setProperty('--so-privacy-height', banner.hidden ? '0px' : `${banner.offsetHeight}px`);
    function update() {
      allow.disabled = api!.browserOptOut();
      status.textContent = api!.browserOptOut()
        ? 'Your browser requests no tracking. Analytics remain off.'
        : '';
      status.hidden = !status.textContent;
      space();
    }
    function hide() {
      banner!.hidden = true;
      space();
      (returnFocus ?? document.querySelector<HTMLElement>('[data-privacy-settings]'))?.focus();
    }
    document.querySelectorAll<HTMLButtonElement>('[data-privacy-settings]').forEach((button) => button.addEventListener('click', () => api.open()));
    window.addEventListener('sourceorrery:privacy-open', () => {
      returnFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      banner.hidden = false;
      update();
      (allow.disabled ? banner.querySelector<HTMLButtonElement>('[data-analytics-choice="denied"]') : allow)?.focus();
    });
    window.addEventListener('sourceorrery:privacy-change', update);
    banner.querySelectorAll<HTMLButtonElement>('[data-analytics-choice]').forEach((button) => button.addEventListener('click', () => {
      api.choose(button.dataset.analyticsChoice as 'granted' | 'denied');
      hide();
    }));
    banner.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && api.choice() !== null) hide();
    });
    if (api.choice() === null) banner.hidden = false;
    new ResizeObserver(space).observe(banner);
    update();
  }
</script>

<style>
  .so-consent[hidden] { display: none; }
  .so-consent {
    position: fixed;
    inset-inline: 0;
    inset-block-end: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    box-sizing: border-box;
    width: 100%;
    max-height: 65vh;
    overflow: auto;
    margin: 0;
    padding: 0.75rem 1.25rem;
    border: 0;
    border-top: 1px solid var(--sl-color-gray-4);
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
    box-shadow: 0 -2px 12px #0001;
    font-family: var(--so-font-ui);
    text-align: start;
  }
  .so-consent__message { flex: 1; min-width: 0; }
  .so-consent p { margin: 0; font-size: 0.85rem; line-height: 1.55; }
  .so-consent .so-consent__status { margin-top: 0.45rem; font-size: 0.78rem; color: var(--sl-color-gray-2); }
  .so-consent__actions { display: flex; flex-shrink: 0; gap: 0.6rem; }
  button { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.45rem 0.8rem; border: 1px solid var(--sl-color-gray-3); border-radius: 2px; color: var(--sl-color-text-accent); background: var(--sl-color-bg); font: inherit; font-size: 0.85rem; cursor: pointer; }
  button:hover { background: var(--sl-color-gray-6); }
  button:focus-visible { outline: 2px solid var(--sl-color-text-accent); outline-offset: 3px; }
  button:disabled { opacity: 0.65; cursor: default; }
  @media (max-width: 40rem) { .so-consent { flex-direction: column; align-items: stretch; gap: 0.65rem; padding: 0.75rem 1rem; } }
  :global(body) { padding-block-end: var(--so-privacy-height, 0px); }
</style>
