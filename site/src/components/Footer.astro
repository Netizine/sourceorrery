---
import Pagination from 'virtual:starlight/components/Pagination';
import FAIcon from './FAIcon.astro';

const isHome = Astro.locals.starlightRoute.id === '';
---

<footer class="so-page-footer"><Pagination /></footer>
<div class="so-footer-note">
	<p class="so-footer-note__brand"><FAIcon name="sourceorrery" family="kit" /> SourceOrrery <span>Open source. Local first.</span></p>
	{isHome && (
		<p class="so-footer-privacy">
			<FAIcon name="cookie-bite" /> SourceOrrery has no cookie banner because I’m not interested in
			stalking you around the internet. SourceOrrery takes privacy so seriously that I even refused
			to build an auto-updater because phoning home once was already one call too many.
		</p>
	)}
	<p>
		Fonts and icons are served by this site. No analytics, tracking cookies or
		third-party asset requests. Your theme preference stays in your browser.
	</p>
</div>
