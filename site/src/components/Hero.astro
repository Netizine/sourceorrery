---
/**
 * Cover-style hero for the landing page.
 *
 * Replaces Starlight's centred hero with an editorial layout: a small
 * letter-spaced kicker, a large serif title whose second line is italic,
 * an italic deck, the actions, and a row of small-caps metadata, with the
 * emblem set to the right like a cover illustration.
 *
 * The copy column is a size container. The title scales with the column so
 * that its first line fits on one line wherever the column is wide enough,
 * up to a 4.5rem ceiling, and the deck runs the full width of the column
 * rather than a fixed measure. The hero itself spans a wider container than
 * the prose beneath it (see "Landing page helpers" in styles/paper.css).
 */
import { Image } from 'astro:assets';
import { LinkButton } from '@astrojs/starlight/components';
import FAIcon from './FAIcon.astro';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, image, actions = [] } = data.hero || {};
const actionIcons: Record<string, string> = {
	'right-arrow': 'arrow-right', 'external': 'arrow-up-right', 'padlock': 'shield-keyhole',
	'github': 'github', 'download': 'download', 'document': 'book-open',
};

// `hero.image` is `{ file }` or `{ light, dark }`; the dark image is hidden on
// the light theme and vice versa with Starlight's `<theme>:sl-hidden` classes.
const art =
	image && 'file' in image
		? [{ src: image.file, hiddenOn: undefined }]
		: image && 'dark' in image
			? [
					{ src: image.dark, hiddenOn: 'light' },
					{ src: image.light, hiddenOn: 'dark' },
				]
			: [];
const alt = (image && 'alt' in image && image.alt) || '';

const meta = [
	{ label: 'Status', value: '0.1.4 · local-first' },
	{ label: 'Licence', value: 'MIT or Apache-2.0' },
	{
		label: 'Source',
		value: 'github.com/Netizine/sourceorrery',
		href: 'https://github.com/Netizine/sourceorrery',
	},
];
---

<section class="so-cover" aria-labelledby="_top">
	<div class="so-cover__copy">
		<p class="so-kicker">Open source · Rust-native · Local-first</p>
		<h1 id="_top" data-page-title set:html={title} />
		{tagline && <p class="so-cover__deck" set:html={tagline} />}
		{
			actions.length > 0 && (
				<div class="so-cover__actions">
					{actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => {
						const external = /^(https?:)?\/\//.test(href);
						return (
							<LinkButton {href} {variant} class:list={[className]} {...attrs} target={external ? '_blank' : attrs.target} rel={external ? 'noopener noreferrer' : attrs.rel}>
								{text}
								{icon && <FAIcon name={actionIcons[icon.name || ''] || 'arrow-right'} family={icon.name === 'github' ? 'brands' : 'duotone'} />}
							</LinkButton>
						);
					})}
				</div>
			)
		}
		<dl class="so-cover__meta">
			{
				meta.map((item) => (
					<div>
						<dt>{item.label}</dt>
						<dd>
							{item.href ? (
								<a href={item.href} target="_blank" rel="noopener noreferrer">
									{item.value}
								</a>
							) : (
								item.value
							)}
						</dd>
					</div>
				))
			}
		</dl>
	</div>
	{
		art.length > 0 && (
			<div class="so-cover__art">
				{art.map(({ src, hiddenOn }) => (
					<Image
						{src}
						{alt}
						width={520}
						height={520}
						loading="eager"
						decoding="async"
						class:list={[hiddenOn && `${hiddenOn}:sl-hidden`]}
					/>
				))}
			</div>
		)
	}
</section>

<style>
	.so-cover {
		display: grid;
		grid-template-columns: 100%;
		gap: 2.5rem;
		align-items: center;
		/* The content panel already pads the top; the kicker sits close under the header. */
		padding-block: clamp(0.5rem, 1.25vw, 1rem) clamp(1rem, 3vw, 2.5rem);
	}

	.so-cover__copy {
		container-type: inline-size;
		min-width: 0;
	}

	.so-kicker {
		font-family: var(--so-font-ui);
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--sl-color-gray-3);
		margin: 0 0 1.4rem;
	}

	h1 {
		font-family: var(--sl-font);
		font-weight: 700;
		/* 7.9cqi keeps the first line, "Secrets belong to the runtime," (about 12.1em), on one line. */
		font-size: clamp(2.5rem, 7.9cqi, 4.5rem);
		line-height: 1.04;
		letter-spacing: -0.022em;
		color: var(--so-heading);
		margin: 0;
	}

	h1 :global(em) {
		font-style: italic;
		font-weight: 500;
		color: var(--sl-color-text-accent);
	}

	.so-cover__deck {
		font-family: var(--sl-font);
		font-style: italic;
		font-size: clamp(1.05rem, 0.95rem + 0.6cqi, 1.3rem);
		line-height: 1.5;
		color: var(--sl-color-gray-2);
		margin: 1.6rem 0 0;
	}

	.so-cover__deck :global(code) {
		font-style: normal;
		font-size: 0.85em;
		background: var(--sl-color-bg-inline-code);
		border-radius: 2px;
		padding: 0.05em 0.3em;
	}

	.so-cover__deck :global(em) {
		font-style: normal;
		font-weight: 600;
	}

	.so-cover__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1.5rem;
		align-items: center;
		margin-top: 2rem;
	}

	.so-cover__meta {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(11rem, max-content));
		gap: 1.25rem 3rem;
		margin: 2.75rem 0 0;
		padding-top: 1.5rem;
		border-top: 1px solid var(--sl-color-hairline);
	}

	.so-cover__meta dt {
		font-family: var(--so-font-ui);
		font-size: 0.66rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--sl-color-gray-4);
		margin: 0 0 0.3rem;
	}

	.so-cover__meta dd {
		margin: 0;
		font-size: 0.95rem;
		color: var(--sl-color-gray-1);
	}

	.so-cover__meta a {
		color: var(--sl-color-text-accent);
		text-decoration: none;
	}

	.so-cover__meta a:hover {
		text-decoration: underline;
	}

	/* A flex box, not `display: block` on the images, so the theme-hidden image stays hidden. */
	.so-cover__art {
		display: flex;
		justify-content: center;
	}

	.so-cover__art img {
		width: min(60%, 16rem);
		height: auto;
	}

	@media (min-width: 60rem) {
		.so-cover {
			/* The copy takes the row; the emblem keeps a fixed share with a floor and a ceiling. */
			grid-template-columns: minmax(0, 1fr) clamp(14rem, 27%, 26rem);
			gap: 3rem;
		}

		.so-cover__art img {
			width: 100%;
		}
	}
</style>
