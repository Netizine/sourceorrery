---
import FAIcon from './FAIcon.astro';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
const actionIcons: Record<string, string> = {
	'right-arrow': 'arrow-right', 'external': 'arrow-up-right', 'padlock': 'shield-keyhole',
	'github': 'github', 'download': 'download', 'document': 'book-open',
};
---

<section class="so-hero" aria-labelledby="_top">
	<div class="so-hero__copy">
		<p class="so-hero__eyebrow"><FAIcon name="sourceorrery" family="kit" /> Open source. Rust native. Local first. <span class="so-hero__version">v0.1.4</span></p>
		<h1 id="_top" data-page-title set:html={title} />
		{tagline && <p class="so-hero__description" set:html={tagline} />}
		{actions.length > 0 && (
			<div class="so-hero__actions">
				{actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant = 'primary' }) => {
					const external = /^https?:\/\//.test(href);
					return (
						<a {...attrs} {href} class:list={['sl-link-button', variant, className]} target={external ? '_blank' : attrs.target} rel={external ? 'noopener noreferrer' : attrs.rel}>
							{text}
							<FAIcon name={actionIcons[icon?.name || ''] || 'arrow-right'} family={icon?.name === 'github' ? 'brands' : 'duotone'} />
						</a>
					);
				})}
			</div>
		)}
		<p class="so-hero__platforms">
			<span><FAIcon name="windows" family="brands" /> Windows</span>
			<span><FAIcon name="apple" family="brands" /> macOS</span>
			<span><FAIcon name="linux" family="brands" /> Linux</span>
			<span class="so-hero__license">MIT / Apache-2.0</span>
		</p>
	</div>
	<aside class="so-hero__manifest" aria-label="An example value-free project manifest">
		<div class="so-hero__manifest-heading"><FAIcon name="file-code" /> <span>sourceorrery.toml</span><span class="so-hero__badge">Safe to commit</span></div>
		<pre><code><span class="so-code-comment"># Your project declares what it needs.</span>{'\n'}<span class="so-code-section">[project]</span>{'\n'}name = <span class="so-code-string">"my-application"</span>{'\n'}vault = <span class="so-code-string">"development"</span>{'\n\n'}<span class="so-code-section">[secrets.database-password]</span>{'\n'}env = <span class="so-code-string">"DATABASE_PASSWORD"</span></code></pre>
		<div class="so-hero__manifest-footer"><FAIcon name="vault" /><p>Secret values stay in your encrypted vault.<br /><strong>Your repository holds the references.</strong></p></div>
	</aside>
</section>
