<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultItems>false</EnableDefaultItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <!-- These projects collect Content; C# compilation uses its real projects. -->
    <NoWarn>$(NoWarn);CS2008</NoWarn>
    <IsPackable>false</IsPackable>
    <Version>0.2.0</Version>
    <RepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../'))</RepositoryRoot>
    <!-- Only maintained source/configuration belongs to these analysis projects.
         C# is collected by its real projects. Dependencies and generated loaders,
         documentation and assets must never become duplicate source modules. -->
    <AnalysisExcludes>$(RepositoryRoot)**/node_modules/**;$(RepositoryRoot)**/target/**;$(RepositoryRoot)**/bin/**;$(RepositoryRoot)**/obj/**;$(RepositoryRoot)**/dist/**;$(RepositoryRoot)**/.astro/**;$(RepositoryRoot)**/__pycache__/**;$(RepositoryRoot)**/.venv/**;$(RepositoryRoot)bindings/dotnet/**;$(RepositoryRoot)bindings/node/index.js;$(RepositoryRoot)bindings/node/index.d.ts;$(RepositoryRoot)site/public/**;$(RepositoryRoot)site/src/assets/**;$(RepositoryRoot)site/src/content/**</AnalysisExcludes>
  </PropertyGroup>
  <ItemGroup>
    <AnalysisCandidate Include="$(RepositoryRoot)crates/**/*;$(RepositoryRoot)bindings/**/*;$(RepositoryRoot)tests/**/*;$(RepositoryRoot)site/**/*;$(RepositoryRoot)scripts/**/*;$(RepositoryRoot).github/**/*"
                       Exclude="$(AnalysisExcludes)" />
    <AnalysisFile Include="@(AnalysisCandidate->WithMetadataValue('Extension', '.rs'));@(AnalysisCandidate->WithMetadataValue('Extension', '.py'));@(AnalysisCandidate->WithMetadataValue('Extension', '.go'));@(AnalysisCandidate->WithMetadataValue('Extension', '.java'));@(AnalysisCandidate->WithMetadataValue('Extension', '.php'));@(AnalysisCandidate->WithMetadataValue('Extension', '.c'));@(AnalysisCandidate->WithMetadataValue('Extension', '.h'));@(AnalysisCandidate->WithMetadataValue('Extension', '.cpp'));@(AnalysisCandidate->WithMetadataValue('Extension', '.hpp'));@(AnalysisCandidate->WithMetadataValue('Extension', '.js'));@(AnalysisCandidate->WithMetadataValue('Extension', '.mjs'));@(AnalysisCandidate->WithMetadataValue('Extension', '.ts'));@(AnalysisCandidate->WithMetadataValue('Extension', '.tsx'));@(AnalysisCandidate->WithMetadataValue('Extension', '.jsx'));@(AnalysisCandidate->WithMetadataValue('Extension', '.css'));@(AnalysisCandidate->WithMetadataValue('Extension', '.astro'));@(AnalysisCandidate->WithMetadataValue('Extension', '.html'));@(AnalysisCandidate->WithMetadataValue('Extension', '.yml'));@(AnalysisCandidate->WithMetadataValue('Extension', '.yaml'));@(AnalysisCandidate->WithMetadataValue('Extension', '.xml'));@(AnalysisCandidate->WithMetadataValue('Extension', '.sh'));@(AnalysisCandidate->WithMetadataValue('Extension', '.ps1'))" />
    <AnalysisTestCandidate Include="$(RepositoryRoot)**/tests/**/*;$(RepositoryRoot)**/__test__/**/*;$(RepositoryRoot)**/conformance/**/*;$(RepositoryRoot)**/src/test/**/*;$(RepositoryRoot)**/tests.rs;$(RepositoryRoot)**/test_*.py;$(RepositoryRoot)**/*_test.py;$(RepositoryRoot)**/*_test.go;$(RepositoryRoot)**/*.test.mjs;$(RepositoryRoot)**/examples/conformance.*;$(RepositoryRoot)**/examples/smoke.c;$(RepositoryRoot)crates/sourceorrery-cli/src/ui/fake.rs"
                           Exclude="$(AnalysisExcludes);$(RepositoryRoot)build/**;$(RepositoryRoot)coverage/**;$(RepositoryRoot).git/**;$(RepositoryRoot).claude/**;$(RepositoryRoot).codex/**;$(RepositoryRoot).agents/**" />
    <AnalysisSourceFile Include="@(AnalysisFile)" Exclude="@(AnalysisTestCandidate)" />
    <AnalysisTestFile Include="@(AnalysisFile)" Exclude="@(AnalysisSourceFile)" />
  </ItemGroup>
</Project>
