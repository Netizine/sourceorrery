<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>SourceOrrery</PackageId>
    <Description>Read-only SourceOrrery SDK for .NET; requires the separate SourceOrrery CLI to create vaults and set secret values. CLI installation: https://sourceorrery.ai/getting-started/#install. Native library for Windows, macOS and Linux, x64 and arm64, included.</Description>
    <PackageTags>secrets;vault;keyring;security;dotenv;sourceorrery</PackageTags>
    <PackageProjectUrl>https://sourceorrery.ai/sdks/dotnet/</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Members of records documented at the type level. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <RootNamespace>SourceOrrery</RootNamespace>
    <!-- Directory with runtimes/<rid>/native/<lib>, filled by the release workflow. -->
    <SourceOrreryRuntimesDir Condition="'$(SourceOrreryRuntimesDir)' == ''">$(MSBuildThisFileDirectory)runtimes</SourceOrreryRuntimesDir>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <!-- Native libraries, when present: runtimes/win-x64/native/sourceorrery_ffi.dll, ... -->
    <None Include="$(SourceOrreryRuntimesDir)\**\*" Condition="Exists('$(SourceOrreryRuntimesDir)')" Pack="true" PackagePath="runtimes\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SourceOrrery.Tests" />
  </ItemGroup>

</Project>
