<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The library targets net8.0; tests run on the current runtime. -->
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!-- Opt in with -p:CollectCoverage=true. Keep VSTest: coverlet.msbuild
       does not instrument tests run through Microsoft.Testing.Platform. -->
  <PropertyGroup Condition="'$(CollectCoverage)' == 'true'">
    <CoverletOutputFormat>opencover</CoverletOutputFormat>
    <CoverletOutput>$(MSBuildThisFileDirectory)../../../coverage/dotnet.xml</CoverletOutput>
    <Include>[SourceOrrery]*</Include>
    <IncludeTestAssembly>false</IncludeTestAssembly>
    <!-- Sonar matches local source paths, not Source Link download URLs. -->
    <UseSourceLink>false</UseSourceLink>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.1" />
    <PackageReference Include="coverlet.msbuild" Version="10.1.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SourceOrrery\SourceOrrery.csproj" />
  </ItemGroup>

</Project>
