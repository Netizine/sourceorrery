<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Run on a newer runtime when exactly .NET 8 is not installed. -->
    <RollForward>Major</RollForward>
    <!--
      Where cargo put the native library. SOURCEORRERY_NATIVE_DIR (as CI sets
      it) wins over the default of target/release at the repository root.
    -->
    <SourceOrreryNativeDir Condition="'$(SourceOrreryNativeDir)' == '' and '$(SOURCEORRERY_NATIVE_DIR)' != ''">$(SOURCEORRERY_NATIVE_DIR)</SourceOrreryNativeDir>
    <SourceOrreryNativeDir Condition="'$(SourceOrreryNativeDir)' == ''">$(MSBuildThisFileDirectory)../../../target/release</SourceOrreryNativeDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SourceOrrery\SourceOrrery.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copy whichever of the three platform libraries exists next to the test output. -->
    <None Include="$(SourceOrreryNativeDir)/*sourceorrery_ffi.dll;$(SourceOrreryNativeDir)/*sourceorrery_ffi.so;$(SourceOrreryNativeDir)/*sourceorrery_ffi.dylib"
          Link="%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>

</Project>
